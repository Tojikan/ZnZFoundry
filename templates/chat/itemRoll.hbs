<div class="chat-card" data-item-id="{{_id}}" data-owner-id="{{owner}}" style="background-color: #CBC3E3">
    {{#if actionName~}}
        <strong>{{actionName}}</strong>
    {{/if}}
    {{#if healthSpend}}
        <div style="color:red">{{actor}} is spending health to perform this action!</div>
    {{/if}}
    {{#if freeRoll}}
        <div style="color:green">Free Roll: No resource cost</div>
    {{/if}}
    {{#if isAdrenaline}}
        <div style="color:green">Adrenaline: Diceface Bonus & No Penalties!</div>
    {{/if}}

    <br/>
    <div class="dice-roll">
        {{#if flavor~}}
            <div class="dice-flavor" style="text-align:left">
                {{flavor}}
            </div>
        {{~/if}}
        <div class="dice-result">
            <div class="dice-formula">{{formula}}</div>
            {{{tooltip}}}
            <h4 class="dice-total">{{total}}</h4>
        </div>
    </div>

    {{#if hasMulti}}
        <div style="margin-top:10px">
            <div>{{{multiplierText}}}</div>
            <div class="dice-roll">
                <div class="dice-result">
                    <div class="dice-formula">{{total}} x {{multiplier}}</div>
                    <h4 class="dice-total">{{totalMultiplied}}</h4>
                </div>
            </div>
        </div>
    {{/if}}
</div>